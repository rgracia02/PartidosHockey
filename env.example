# Copiá este archivo como ".env.local" (NO lo subas a GitHub) y completá con los datos de tu
# proyecto de Firebase (Configuración del proyecto → Tus apps → Configuración del SDK).
# Sin estas variables la app funciona igual, solo que sin compartir torneos en la nube.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
