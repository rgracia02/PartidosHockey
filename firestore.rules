rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appConfig/authorizedCreators {
      // Solo usuarios con sesión iniciada pueden leer la lista de organizadores (son correos personales).
      allow read: if request.auth != null;
      allow create: if false;
      allow update, delete: if request.auth != null && request.auth.token.email in resource.data.emails;
    }
    match /sharedTournaments/{shareId} {
      // Quien tenga el código del link puede abrir ese torneo, pero nadie puede listarlos todos.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasAll(['ownerUid', 'ownerEmail', 'editorEmails', 'payload', 'updatedAt'])
                    && request.auth.token.email in get(/databases/$(database)/documents/appConfig/authorizedCreators).data.emails;
      allow update: if request.auth != null && (
        (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid) ||
        (request.auth.token.email in resource.data.editorEmails && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.editorEmails == resource.data.editorEmails)
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
